node_modules/
dist/
.venv/
__pycache__/
*.pyc
out/

# tsc must only ever emit into dist/
packages/*/src/*.js
packages/*/src/*.d.ts

# Copied into the package by prepack; the source of truth is /pipeline
packages/cli/pipeline/

# Generated by the test fixtures
pipeline/test/*.wav
pipeline/test/*.cwi.json
pipeline/test/*.words.json
pipeline/test/*.srt

# Third-party, and NOT ours to redistribute. The Caption with Intention design
# system PDF is marked "All Rights Reserved" on every page. Download it from
# https://www.captionwithintention.org/ instead of committing it here.
Caption-With-Intention_Design-System_V1.0.pdf
*.pdf

# Media. The small demo assets are committed so the demo runs from a clean
# clone; larger or personal renders are not.
*.mp4
*.wav
*.mov
*.webm
!apps/demo/public/scene.mp4
!apps/demo/public/control-room.mp4
# Rendered examples. Committed because the whole argument of this project is
# visual — a palette that collapses under dichromacy, a reveal that stays in
# step across four languages — and a reader should not have to install
# ffmpeg and a headless browser to see it. Kept small and regenerable.
!examples/*.mp4
# Copied into the package by prepack; the source of truth is /conformance
packages/cli/conformance/

# macOS Finder metadata, which follows you into every directory
.DS_Store
