{
  "name": "cwi-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Caption with Intention toolchain: analyze media, assign accessible colours, validate caption tracks, preview, and export.",
  "type": "module",
  "bin": {
    "cwi-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cwi-cli": "^0.1.0",
    "cwi-core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": "Zubeid Hendricks",
  "homepage": "https://github.com/ZubeidHendricks/caption-with-intent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZubeidHendricks/caption-with-intent.git",
    "directory": "packages/cwi-mcp"
  },
  "bugs": {
    "url": "https://github.com/ZubeidHendricks/caption-with-intent/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "captions",
    "subtitles",
